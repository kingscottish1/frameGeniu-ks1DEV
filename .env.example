# =============================================================================
# FrameGenius environment — copy to .env  (INSTALL.bat / bootstrap does this)
# NEVER commit a filled .env. Permissions should be 600.
# =============================================================================

# AES-256 master key (urlsafe base64, 32 bytes). Auto-generated on first boot.
FRAMEGENIUS_MASTER_KEY=

# Studio login  (0 = open like MoneyPrinterTurbo, no gate)
FRAMEGENIUS_AUTH=0
FRAMEGENIUS_ADMIN_USER=admin
FRAMEGENIUS_ADMIN_PASSWORD=FrameGenius!
FRAMEGENIUS_LLM_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Set to 1 once if you intentionally rotate the admin password from this file
FRAMEGENIUS_RESET_ADMIN=0

# Cookies. Enable on HTTPS deployments.
FRAMEGENIUS_COOKIE_SECURE=0
FRAMEGENIUS_HSTS=0

# Comma-separated extra CORS origins (dashboard is same-origin and does not need this)
FRAMEGENIUS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
FRAMEGENIUS_PUBLIC_ORIGIN=

# Expose Swagger at /docs without a session (keep off in production)
FRAMEGENIUS_EXPOSE_DOCS=0

# Optional provider keys — also accepted in config.toml
# FRAMEGENIUS_LLM_PROVIDER=demo
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# UPLOAD_POST_API_KEY=
